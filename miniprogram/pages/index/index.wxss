page { background: #fff6e5; }
.home-page { width: 100%; max-width: 680px; margin: 0 auto; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; }

/* The approved 1122 x 1402 illustration is a single cached artwork atlas.
   Each native control clips its own region; touch targets and labels stay native. */
.home-art { position: absolute; display: block; max-width: none; z-index: 1; pointer-events: none; }
.home-hero { position: relative; height: 414.44rpx; overflow: hidden; }
.hero-art { width: 100%; height: 226.129%; left: 0; top: 0; }
.hero-fallback { display: block; width: 100%; height: 100%; }
.home-actions { margin: 5.35rpx 62.83rpx 0; }

button.entry, button.small-entry { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; padding: 0; overflow: hidden; border: 0; line-height: 1.3; font-family: 'Songti SC', 'Noto Serif CJK SC', 'SimSun', serif; }
button.entry::after, button.small-entry::after { border: 0; }
.artwork-ready button.entry, .artwork-ready button.small-entry { border-radius: 0; background: transparent; }
button.entry { width: 100%; height: 98.26rpx; border-radius: 56rpx; margin: 0; }
.entry-primary { background: #256b5c; color: #fff5df; }
button.entry-secondary { margin-top: 10.03rpx; height: 97.59rpx; }
.entry-secondary[disabled] { background: #d9dfcc; color: #405d51; }
.entry-label { display: block; text-align: left; font-size: 34rpx; font-weight: 600; }
.entry-arrow { position: absolute; right: 35rpx; top: 22rpx; font-size: 42rpx; }
.coming-soon { display: block; font-size: 22rpx; line-height: 1.5; font-weight: 400; }
.primary-art { width: 120.1285%; height: 953.7415%; left: -10.0642%; top: -427.2109%; }
.secondary-art { width: 120.1285%; height: 960.274%; left: -10.0642%; top: -541.0959%; }
.entry-pressed { opacity: .86; transform: translateY(1px); }

.secondary-actions { display: flex; gap: 7.35rpx; margin-top: 14.71rpx; }
button.small-entry { width: 49.2505%; flex: none; height: 93.58rpx; border-radius: 40rpx; margin: 0; font-size: 30rpx; font-weight: 600; text-align: center; }
.mbti-entry[disabled], .placeholder-entry[disabled] { background: #faf0d9; color: #385e50; }
.mbti-art { width: 243.913%; height: 1001.4286%; left: -20.4348%; top: -684.2857%; }
.placeholder-art { width: 243.913%; height: 1001.4286%; left: -122.8261%; top: -684.2857%; }

.alan-signature { position: relative; height: 193.85rpx; margin-top: 9.36rpx; overflow: hidden; color: #5b7367; text-align: center; }
.footer-art { width: 100%; height: 483.4483%; left: 0; top: -383.4483%; }
.signature-caption { position: absolute; top: 34rpx; left: 0; right: 0; font-size: 22rpx; letter-spacing: 7rpx; }
.signature-note { position: absolute; bottom: 40rpx; left: 0; right: 0; font-size: 16rpx; letter-spacing: 5rpx; }
.signature-name { position: absolute; right: 66rpx; bottom: 20rpx; font-size: 20rpx; color: #8d9c87; font-family: Georgia, serif; font-style: italic; }
