page { background: #faf3e7; }
.home-page { width: 100%; box-sizing: border-box; max-width: 680px; margin: 0 auto; padding-bottom: 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.home-hero { display: block; width: 100%; }
.home-actions { padding: 24rpx 32rpx 0; background: linear-gradient(#eae8dc, #faf3e7 110rpx); }
button.entry { width: 100%; box-sizing: border-box; display: flex; align-items: center; min-height: 116rpx; line-height: 1.35; padding: 22rpx 28rpx; margin: 0 0 22rpx; border-radius: 24rpx; border: 2rpx solid #b9a46d; box-shadow: 0 4rpx 0 #564b2512; }
.entry-primary { color: #fff3d6; background: linear-gradient(120deg, #1b4650, #285960); }
.entry-secondary { color: #193c46; border-color: #8baaa0; background: linear-gradient(120deg, #d7ecec, #bcd9e4); }
.entry-icon { width: 74rpx; height: 74rpx; margin-right: 24rpx; border-radius: 12rpx; flex-shrink: 0; }
.entry-label { text-align: left; font-size: 33rpx; font-weight: 600; flex: 1; }
.entry-arrow { font-size: 54rpx; font-weight: 300; margin-left: 14rpx; line-height: 1; }
.secondary-actions { display: flex; }
button.small-entry { flex: 1; width: auto; min-width: 0; padding: 14rpx 8rpx; min-height: 44px; line-height: 1.6; border: 1rpx solid #9ab3a3; border-radius: 14rpx; font-size: 27rpx; margin: 0; display: flex; align-items: center; justify-content: center; }
.mbti-entry { background: #dcece0; color: #244e43; }
button.mbti-entry { margin-right: 16rpx; }
.placeholder-entry[disabled] { background: #e4e3df; color: #989b94; border-color: #c9cac5; }
.entry-pressed { opacity: 0.83; transform: translateY(1px); }
