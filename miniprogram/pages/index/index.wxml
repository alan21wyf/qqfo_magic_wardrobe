<view class="home-page">
  <image class="home-hero" src="/images/wardrobe/home-hero.jpg" mode="widthFix" aria-label="天都魔法衣橱与整理领带的火鸟" />
  <view class="home-actions">
    <button class="entry entry-primary" bindtap="openBuildPreview" hover-class="entry-pressed" aria-label="装备属性试穿">
      <image class="entry-icon" src="/images/wardrobe/helmet.jpg" mode="aspectFit" />
      <text class="entry-label">装备属性试穿</text><text class="entry-arrow">›</text>
    </button>
    <button class="entry entry-secondary" bindtap="showComingSoon" data-label="时装试穿" hover-class="entry-pressed">
      <image class="entry-icon" src="/images/wardrobe/robe.jpg" mode="aspectFit" />
      <text class="entry-label">时装试穿</text><text class="entry-arrow">›</text>
    </button>
    <view class="secondary-actions">
      <button class="small-entry mbti-entry" bindtap="showComingSoon" data-label="幻想MBTI测试" hover-class="entry-pressed">幻想MBTI测试</button>
      <button class="small-entry placeholder-entry" disabled>敬请期待</button>
    </view>
  </view>
</view>
