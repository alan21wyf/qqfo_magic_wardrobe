<view class="home-page {{artworkFailed ? 'artwork-failed' : 'artwork-ready'}}">
  <view class="home-hero" role="img" aria-label="天都云海中的魔法衣橱，火鸟正在整理领带">
    <image wx:if="{{!artworkFailed}}" class="home-art hero-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
    <image wx:else class="hero-fallback" src="/images/wardrobe/home-hero.jpg" mode="aspectFill" aria-hidden="{{true}}" />
  </view>
  <view class="home-actions">
    <button class="entry entry-primary" bindtap="openBuildPreview" hover-class="entry-pressed" aria-label="装备属性试穿">
      <text class="entry-label">装备属性试穿</text><text class="entry-arrow" aria-hidden="{{true}}">›</text>
      <image wx:if="{{!artworkFailed}}" class="home-art primary-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
    </button>
    <button class="entry entry-secondary" disabled="{{true}}" aria-label="时装试穿，即将推出">
      <text class="entry-label">时装试穿<text class="coming-soon">即将推出</text></text>
      <image wx:if="{{!artworkFailed}}" class="home-art secondary-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
    </button>
    <view class="secondary-actions">
      <button class="small-entry mbti-entry" disabled="{{true}}" aria-label="幻想MBTI，即将推出">
        <text>幻想MBTI<text class="coming-soon">即将推出</text></text>
        <image wx:if="{{!artworkFailed}}" class="home-art mbti-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
      </button>
      <button class="small-entry placeholder-entry" disabled="{{true}}" aria-label="敬请期待">
        <text>敬请期待</text>
        <image wx:if="{{!artworkFailed}}" class="home-art placeholder-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
      </button>
    </view>
  </view>
  <view class="alan-signature" aria-label="幻想不散场，献给每一位幻想玩家。Alan">
    <text class="signature-caption">幻想不散场</text>
    <text class="signature-note">献给每一位幻想玩家</text>
    <text class="signature-name">Alan</text>
    <image wx:if="{{!artworkFailed}}" class="home-art footer-art" src="/images/wardrobe/home-artwork.jpg" mode="scaleToFill" aria-hidden="{{true}}" binderror="onArtworkError" />
  </view>
</view>
