}

/* Portrait operation controls and retained, inactive equipment. */
.equipment-mode-controls { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--mode-gap, 10px); padding: 4px; box-sizing: border-box; }
button.equipment-mode-button { width: 90%; max-width: 176px; min-width: 0; min-height: 0; height: var(--mode-height, 44px); box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 4px; line-height: 1.2; font-size: var(--mode-font, 14px); color: #e8d2a4; border: 1px solid #88704a; border-radius: 9px; background: linear-gradient(145deg, #393326ed, #1e2723f2); box-shadow: 0 2px 7px #0005; }
button.equipment-mode-button.mode-selected { color: #fff2cc; border-color: #d4b575; background: linear-gradient(145deg, #755832f2, #423626f2); }
button.clear-mode-button { color: #e0b3a0; border-color: #86604c; }
.equipment-mode-button[disabled] { opacity: 0.45; }
button.future-mode-button[disabled] { opacity: 0.6; }
.takeoff-hint { position: fixed; z-index: 19; top: var(--hint-top, 76px); left: 50%; transform: translateX(-50%); width: 230px; max-width: calc(100vw - 24px); padding: 9px 12px; box-sizing: border-box; background: #16251ff2; border: 1px solid #a69262; color: #f4e4bd; border-radius: 8px; font-size: 12px; line-height: 1.5; text-align: center; pointer-events: none; opacity: 1; transition: opacity 0.5s ease; }
.takeoff-hint-fading { opacity: 0; }
.equipment-inactive .equipment-icon, .equipment-inactive .badge { filter: grayscale(100%); opacity: 0.4; }
.equipment-inactive .slot-indicator { color: #b6b9a7; }
.legacy-field-note { display: block; margin-top: 3px; font-size: 10px; color: #9c815b; }
.pending-values { display: block; font-size: 12px; color: #4b6252; margin-top: 5px; line-height: 1.6; }

/* Each window gets its own layout variables; only very short/wide windows use paired panels. */
.equipment-slot > text { flex-shrink: 0; }
.equipment-slot .slot-indicator { position: absolute; top: 1px; right: 1px; line-height: 10px; background: #163128d9; border-radius: 2px; padding: 1px 2px; }
.preview-footer .equipment-icon { width: var(--artifact-icon, 30px); height: var(--artifact-icon, 30px); flex-shrink: 0; }
.extra-stats > text { min-width: 0; white-space: nowrap; }
.layout-wide .attribute-panels { flex-direction: row; }
.layout-stacked .stat-cell { flex-direction: column; justify-content: center; align-items: stretch; padding: 0 4px; }
.layout-stacked .stat-label { margin: 0; line-height: 1.05; }
.layout-stacked .stat-value { flex: none; width: 100%; line-height: 1.05; }
.layout-landscape { display: grid; grid-template-columns: minmax(0, 42fr) minmax(0, 58fr); grid-template-rows: var(--profession-height) var(--status-height) var(--badges-height) var(--vitals-height) minmax(0, 1fr) var(--footer-height) var(--extra-height); }
.layout-landscape .profession-list { grid-column: 1 / 3; grid-row: 1; }
.layout-landscape .status-note, .layout-landscape > .error-notice { grid-column: 1 / 3; grid-row: 2; }
.layout-landscape .equipment-layout { grid-column: 1; grid-row: 3 / 8; }
.layout-landscape .badges { grid-column: 2; grid-row: 3; }
.layout-landscape .vital-stats { grid-column: 2; grid-row: 4; }
.layout-landscape .attribute-panels { grid-column: 2; grid-row: 5; min-height: 0; }
.layout-landscape .preview-footer { grid-column: 2; grid-row: 6; }
.layout-landscape .extra-stats { grid-column: 2; grid-row: 7; }
.preset-overlay { z-index: 18; }
